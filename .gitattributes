# Rainmeter needs .ini/.inc as UTF-16 LE with BOM; store them as UTF-8 so GitHub shows readable diffs.
*.ini text working-tree-encoding=UTF-16LE-BOM eol=crlf
*.inc text working-tree-encoding=UTF-16LE-BOM eol=crlf
*.png binary
# the package manifest is plain UTF-8
RMSKIN.ini text -working-tree-encoding
*.jpg binary
# ToDo.lua is UTF-16 so Rainmeter hands Lua UTF-8 (emoji, any script)
Skins/Pulse/@Resources/ToDo.lua text working-tree-encoding=UTF-16LE-BOM eol=crlf
